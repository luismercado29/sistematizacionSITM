# Copia este archivo como .env y rellena los valores.
# El .env real NO se sube a git (esta en .gitignore).

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# true en local, false en produccion
DEBUG=true

# Dominios permitidos, separados por coma. Ej: midominio.com,www.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes confiables para CSRF, separados por coma. Ej: https://midominio.com
CSRF_TRUSTED_ORIGINS=

# Cadena de conexion de Neon (Postgres). Si se deja vacia se usa SQLite local.
# Formato: postgresql://usuario:password@host/basedatos?sslmode=require
DATABASE_URL=

# Despacho automatico para demos (true/false). NUNCA en operacion real.
SITM_MODO_DEMO=false

# Segundos entre actualizaciones del mapa en vivo.
SITM_REFRESCO_S=10

# Token PUBLICO de Mapbox (pk.*) para los mapas. Vacio = OpenStreetMap.
# Restringelo en https://account.mapbox.com a tus dominios (localhost y el de Vercel).
MAPBOX_TOKEN=

# Ruta del panel de administracion (por defecto admin/). En produccion usa una
# ruta poco obvia, p. ej. gestion-7f3k/
ADMIN_URL=admin/
